# frozen_string_literal: true

source "https://rubygems.org"

# JRuby 10.1 implements Ruby 4.0
ruby "~> 4.0"

# openhab-scripting depends on an "openhab" gem that the live openHAB JVM provides and rubygems.org doesn't have; this
# plugin stands in for it outside the JVM, taking the version from OPENHAB_USERDATA's version.properties
plugin "bundler-openhab-stub"

group(:test) do
  gem "rspec", "~> 3.11"
  gem "rubocop"
  gem "rubocop-openhab-scripting"
  gem "rubocop-performance"
  gem "rubocop-rspec"
  gem "timecop", "~> 0.9"
end

group(:openhab) do
  gem "activesupport", "~> 8.1", require: false
  gem "minitest", "~> 5", require: false
  gem "openhab-scripting", "~> 5.52", path: "/home/kgarner/openhab-dev/openhab-jruby"
  # openhab-scripting's rspec harness requires nokogiri (openhab/osgi.rb) without declaring it
  gem "nokogiri"
end
